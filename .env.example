# Spring Boot store backend (not the MCP server URL)
STORE_API_URL=http://localhost:8080
# Create a read-only key in the seller dashboard: /seller/api-keys
STORE_API_KEY=store_sk_REPLACE_WITH_YOUR_GENERATED_KEY
STORE_TIMEOUT_SECONDS=15
# Use only for an isolated trusted Docker network (HTTPS recommended otherwise)
# STORE_ALLOW_INSECURE_HTTP=true
